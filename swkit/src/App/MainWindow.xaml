<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ============ 侧栏 ============ -->
    <Border Grid.Column="0" Background="{StaticResource B.Sidebar}" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,1,0">
        <DockPanel Margin="14,0,14,16">
            <!-- 品牌 -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,20,0,28">
                <!-- 品牌标志：和程序图标同一张图（橙色立方体 SW + tool，tools\make-icon.ps1 生成） -->
                <Image x:Name="BrandLogo" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SW 工具箱" FontSize="14" FontWeight="Bold" Foreground="{StaticResource B.Text}"/>
                    <TextBlock Text="AI × SolidWorks" FontSize="11" Foreground="{StaticResource B.Text2}" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- SolidWorks 状态 -->
            <Border DockPanel.Dock="Bottom" CornerRadius="12" Background="#EBEBEF" Padding="12,11,12,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse x:Name="SwDotHalo" Width="8" Height="8" Fill="#34C759" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="SwDot" Width="8" Height="8" Fill="#A1A1A6"/>
                        </Grid>
                        <TextBlock x:Name="SwTitle" Text="正在检查 SolidWorks…" Margin="9,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"/>
                    </StackPanel>
                    <TextBlock x:Name="SwDetail" Margin="17,4,0,0" FontSize="11" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" LineHeight="16"/>
                    <Button x:Name="WorkerCloseBtn" Style="{StaticResource Btn.Text}" Content="关闭后台 SolidWorks" FontSize="11.5" Margin="11,4,0,0" HorizontalAlignment="Left" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 导航 -->
            <StackPanel>
                <TextBlock Text="工具" Style="{StaticResource T.Section}" Margin="10,0,0,6"/>
                <RadioButton x:Name="NavExport" Style="{StaticResource Nav}" Tag="&#xEDE1;" Content="一键导出"/>
                <RadioButton x:Name="NavUrdf" Style="{StaticResource Nav}" Tag="&#xE71B;" Content="URDF 导出"/>
                <RadioButton x:Name="NavParts" Style="{StaticResource Nav}" Tag="&#xEA86;" Content="标准件库"/>
                <RadioButton x:Name="NavFea" Style="{StaticResource Nav}" Tag="&#xE9D9;" Content="应力分析"/>
                <RadioButton x:Name="NavDfm" Style="{StaticResource Nav}" Tag="&#xE9F5;" Content="可制造性"/>
                <RadioButton x:Name="NavWorkspace" Style="{StaticResource Nav}" Tag="&#xE8B7;" Content="工作区"/>

                <TextBlock Text="AI" Style="{StaticResource T.Section}" Margin="10,20,0,6"/>
                <RadioButton x:Name="NavPrompts" Style="{StaticResource Nav}" Tag="&#xEA80;" Content="AI 建模提示词"/>
                <RadioButton x:Name="NavApi" Style="{StaticResource Nav}" Tag="&#xE943;" Content="AI 控制接口"/>
            </StackPanel>
        </DockPanel>
    </Border>

    <!-- ============ 内容 ============ -->
    <Grid Grid.Column="1" ClipToBounds="True">
        <Grid x:Name="PageHost"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="MinBtn" Style="{StaticResource Btn.Caption}" Content="&#xE921;" ToolTip="最小化"/>
            <Button x:Name="MaxBtn" Style="{StaticResource Btn.Caption}" Content="&#xE922;" ToolTip="最大化"/>
            <Button x:Name="CloseBtn" Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" ToolTip="关闭"/>
        </StackPanel>
    </Grid>
</Grid>
