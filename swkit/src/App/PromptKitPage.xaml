<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 标题 -->
    <StackPanel Margin="36,40,150,18">
        <TextBlock Text="AI 建模提示词" Style="{StaticResource T.LargeTitle}"/>
        <TextBlock Style="{StaticResource T.Secondary}" Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left"
                   Text="把零件照片发给你自己的 AI，得到尺寸表、特征树和逐步建模步骤，还能生成在 SolidWorks 里一键运行的建模宏。先选你用的 AI，然后在下面直接阅读、复制，安装包也可以直接复制或安装。"/>
    </StackPanel>

    <!-- 选 AI -->
    <UniformGrid x:Name="KitTabs" Grid.Row="1" Columns="3" Margin="36,0,30,14"/>

    <!-- 阅读器 -->
    <Grid Grid.Row="2" Margin="36,0,30,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                <StackPanel x:Name="FileList"/>
            </ScrollViewer>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="20,12,14,12">
                    <DockPanel>
                        <WrapPanel x:Name="DocActions" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="DocTitle" Style="{StaticResource T.Headline}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="DocSub" FontSize="11.5" Foreground="{StaticResource B.Text3}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <FlowDocumentScrollViewer x:Name="Reader" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>
    </Grid>
</Grid>
