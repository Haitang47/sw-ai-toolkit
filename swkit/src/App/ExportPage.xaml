<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PageRoot" AllowDrop="True" Background="White">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="356"/>
    </Grid.ColumnDefinitions>

    <!-- ============ 标题 ============ -->
    <StackPanel Grid.ColumnSpan="2" Margin="36,40,150,20">
        <TextBlock Text="一键导出" Style="{StaticResource T.LargeTitle}"/>
        <TextBlock Style="{StaticResource T.Secondary}" Margin="0,6,0,0" MaxWidth="660" HorizontalAlignment="Left"
                   Text="把 SolidWorks 零件、装配体和工程图批量转成常用格式。导出在后台独立的 SolidWorks 里进行，不会打扰你正在做的工作。"/>
    </StackPanel>

    <!-- ============ 左侧：文件 ============ -->
    <Grid Grid.Row="1" Margin="36,4,20,22">
        <!-- 空状态：拖放区 -->
        <Grid x:Name="EmptyState">
            <Rectangle RadiusX="16" RadiusY="16" Stroke="#C9C9CF" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="#FAFAFC"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <Border Width="68" Height="68" CornerRadius="20" Background="{StaticResource B.AccentTint}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE898;" Style="{StaticResource T.Icon}" FontSize="28" Foreground="{StaticResource B.Accent}"/>
                </Border>
                <TextBlock Text="把文件或文件夹拖到这里" Style="{StaticResource T.Title}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                <TextBlock Style="{StaticResource T.Secondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="380"
                           Text="支持零件、装配体和工程图；文件夹会自动查找里面所有的 SolidWorks 文件"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button x:Name="EmptyAddFiles" Style="{StaticResource Btn.Secondary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock Text="选择文件"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="EmptyAddFolder" Style="{StaticResource Btn.Secondary}" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock Text="选择文件夹"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 文件列表 -->
        <Border x:Name="ListCard" Style="{StaticResource Card}" Visibility="Collapsed">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="18,12,10,10">
                    <TextBlock x:Name="FileSummary" Style="{StaticResource T.Headline}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="AddFilesBtn" Style="{StaticResource Btn.Text}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource T.Icon}" FontSize="11" Margin="0,0,5,0"/>
                                <TextBlock Text="添加文件"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddFolderBtn" Style="{StaticResource Btn.Text}" Margin="2,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,5,0"/>
                                <TextBlock Text="添加文件夹"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearBtn" Style="{StaticResource Btn.Text}" Margin="2,0,0,0" Content="清空"/>
                    </StackPanel>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource B.Line}"/>
                <ListBox x:Name="FileList" BorderThickness="0" Background="Transparent" Padding="8,6,8,8"
                         ItemContainerStyle="{StaticResource Row}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="kindBox" Width="34" Height="34" CornerRadius="9" Background="#EAF3FE" VerticalAlignment="Top">
                                    <TextBlock x:Name="kindText" Text="零" FontSize="13" FontWeight="SemiBold" Foreground="#0071E3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Medium" Foreground="#1D1D1F" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Folder}" FontSize="11.5" Foreground="#A1A1A6" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Path}"/>
                                    <TextBlock x:Name="msg" Text="{Binding Message}" FontSize="11.5" Foreground="#6E6E73" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="16"/>
                                </StackPanel>
                                <Border x:Name="pill" Grid.Column="2" CornerRadius="10" Padding="9,3" Background="#F2F2F4" VerticalAlignment="Center">
                                    <TextBlock x:Name="pillText" Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#6E6E73"/>
                                </Border>
                                <Button x:Name="RemoveBtn" Grid.Column="3" Style="{StaticResource Btn.Icon}" Margin="6,0,0,0" ToolTip="从列表移除" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9"/>
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Assembly">
                                    <Setter TargetName="kindBox" Property="Background" Value="#F3EBF8"/>
                                    <Setter TargetName="kindText" Property="Text" Value="装"/>
                                    <Setter TargetName="kindText" Property="Foreground" Value="#8944AB"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Drawing">
                                    <Setter TargetName="kindBox" Property="Background" Value="#FFF2E0"/>
                                    <Setter TargetName="kindText" Property="Text" Value="图"/>
                                    <Setter TargetName="kindText" Property="Foreground" Value="#B25000"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Message}" Value="">
                                    <Setter TargetName="msg" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                    <Setter TargetName="pill" Property="Background" Value="#EAF3FE"/>
                                    <Setter TargetName="pillText" Property="Foreground" Value="#0071E3"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Done">
                                    <Setter TargetName="pill" Property="Background" Value="#E8F6EC"/>
                                    <Setter TargetName="pillText" Property="Foreground" Value="#248A3D"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                    <Setter TargetName="pill" Property="Background" Value="#FFF2E0"/>
                                    <Setter TargetName="pillText" Property="Foreground" Value="#B25000"/>
                                    <Setter TargetName="msg" Property="Foreground" Value="#B25000"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter TargetName="pill" Property="Background" Value="#FFECEB"/>
                                    <Setter TargetName="pillText" Property="Foreground" Value="#D70015"/>
                                    <Setter TargetName="msg" Property="Foreground" Value="#D70015"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 拖入时的高亮层 -->
        <Border x:Name="DropOverlay" CornerRadius="16" Background="#F0EAF3FE" BorderBrush="#0071E3" BorderThickness="2"
                IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE898;" Style="{StaticResource T.Icon}" FontSize="34" Foreground="{StaticResource B.Accent}"/>
                <TextBlock Text="松开即可添加" Style="{StaticResource T.Title}" Foreground="{StaticResource B.Accent}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>

    <!-- ============ 右侧：设置 ============ -->
    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Margin="0,4,0,0" Padding="0,0,30,22">
        <StackPanel x:Name="SettingsPanel">
            <TextBlock Text="导出格式" Style="{StaticResource T.Section}"/>
            <Border Style="{StaticResource Group}" Padding="12,12,4,4">
                <StackPanel>
                    <UniformGrid Columns="2">
                        <ToggleButton x:Name="FmtStep" Style="{StaticResource Chip}" Content="STEP"/>
                        <ToggleButton x:Name="FmtStl" Style="{StaticResource Chip}" Content="STL"/>
                        <ToggleButton x:Name="Fmt3mf" Style="{StaticResource Chip}" Content="3MF"/>
                        <ToggleButton x:Name="FmtXt" Style="{StaticResource Chip}" Content="Parasolid"/>
                        <ToggleButton x:Name="FmtIges" Style="{StaticResource Chip}" Content="IGES"/>
                        <ToggleButton x:Name="FmtFlat" Style="{StaticResource Chip}" Content="钣金展开 DXF"/>
                    </UniformGrid>
                    <TextBlock Text="工程图" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource B.Text2}" Margin="3,6,0,8"/>
                    <UniformGrid Columns="3">
                        <ToggleButton x:Name="FmtPdf" Style="{StaticResource Chip}" Content="PDF"/>
                        <ToggleButton x:Name="FmtDwg" Style="{StaticResource Chip}" Content="DWG"/>
                        <ToggleButton x:Name="FmtDxf" Style="{StaticResource Chip}" Content="DXF"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <StackPanel x:Name="StepSection">
                <TextBlock Text="STEP" Style="{StaticResource T.Section}"/>
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="协议版本" FontSize="13" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Ap214" GroupName="ap" Style="{StaticResource Segment}" Content="AP214"/>
                                    <RadioButton x:Name="Ap203" GroupName="ap" Style="{StaticResource Segment}" Content="AP203"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="AP214 带颜色，兼容性最好；AP203 留给很老的软件。" Style="{StaticResource T.Caption}" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="StlSection">
                <TextBlock Text="STL 网格" Style="{StaticResource T.Section}"/>
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="精度" FontSize="13" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="StlFine" GroupName="stlq" Style="{StaticResource Segment}" Content="精细"/>
                                    <RadioButton x:Name="StlCoarse" GroupName="stlq" Style="{StaticResource Segment}" Content="粗糙"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="单位" FontSize="13" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="UnitMm" GroupName="unit" Style="{StaticResource Segment}" Content="毫米"/>
                                    <RadioButton x:Name="UnitM" GroupName="unit" Style="{StaticResource Segment}" Content="米"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <CheckBox x:Name="KeepCoords" Style="{StaticResource Switch}">
                            <StackPanel>
                                <TextBlock Text="保持模型原坐标"/>
                                <TextBlock Text="导出 URDF 网格、多零件对位打印时请打开" Style="{StaticResource T.Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="AsmOneFile" Style="{StaticResource Switch}">
                            <StackPanel>
                                <TextBlock Text="装配体合并成一个文件"/>
                                <TextBlock Text="关闭后每个零部件单独一个 STL" Style="{StaticResource T.Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="StlBinary" Style="{StaticResource Switch}">
                            <StackPanel>
                                <TextBlock Text="二进制格式"/>
                                <TextBlock Text="文件更小；关闭后为文本格式" Style="{StaticResource T.Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="FlatSection">
                <TextBlock Text="钣金展开" Style="{StaticResource T.Section}"/>
                <Border Style="{StaticResource Group}">
                    <CheckBox x:Name="BendLines" Style="{StaticResource Switch}">
                        <StackPanel>
                            <TextBlock Text="包含折弯线"/>
                            <TextBlock Text="激光切割下料一般不需要" Style="{StaticResource T.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </Border>
            </StackPanel>

            <TextBlock Text="输出" Style="{StaticResource T.Section}"/>
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="保存到" FontSize="13" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="OutSource" GroupName="out" Style="{StaticResource Segment}" Content="源文件旁边"/>
                                <RadioButton x:Name="OutCustom" GroupName="out" Style="{StaticResource Segment}" Content="指定文件夹"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid x:Name="OutFolderRow" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="8" Background="{StaticResource B.Fill}" Padding="10,7">
                            <TextBlock x:Name="OutFolderText" FontSize="12" Foreground="{StaticResource B.Text2}" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Button x:Name="ChooseOutBtn" Grid.Column="1" Style="{StaticResource Btn.Secondary}" Content="选择…" Margin="8,0,0,0"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="Subfolders" Style="{StaticResource Switch}" Content="每种格式放进单独的文件夹"/>
                    <CheckBox x:Name="AllConfigs" Style="{StaticResource Switch}">
                        <StackPanel>
                            <TextBlock Text="导出所有配置"/>
                            <TextBlock Text="文件名后面加上 _配置名" Style="{StaticResource T.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="Overwrite" Style="{StaticResource Switch}">
                        <StackPanel>
                            <TextBlock Text="覆盖同名文件"/>
                            <TextBlock Text="关闭后自动另起名字，例如 零件 (2).step" Style="{StaticResource T.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                <TextBlock Text="&#xE946;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{StaticResource B.Text3}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                <TextBlock Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text3}" MaxWidth="290"
                           Text="第一次导出需要 20–60 秒启动后台 SolidWorks，之后 10 分钟内再导出不用等。导出的是磁盘上已保存的版本。"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

    <!-- ============ 日志抽屉 ============ -->
    <Border x:Name="LogPanel" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="0" Margin="36,0,30,0"
            Background="#FBFBFD" BorderBrush="{StaticResource B.Line}" BorderThickness="1,1,1,0" CornerRadius="12,12,0,0">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="16,8,8,4">
                <TextBlock Text="详细日志" Style="{StaticResource T.Headline}" VerticalAlignment="Center"/>
                <Button x:Name="CopyLogBtn" Style="{StaticResource Btn.Text}" Content="复制全部" HorizontalAlignment="Right"/>
            </Grid>
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Padding="16,0,12,10">
                <StackPanel x:Name="LogLines"/>
            </ScrollViewer>
        </DockPanel>
    </Border>

    <!-- ============ 底栏 ============ -->
    <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Background="#FCFCFD">
        <DockPanel Margin="36,14,30,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="LogToggleBtn" Style="{StaticResource Btn.Text}" Content="显示日志" VerticalAlignment="Center"/>
                <Button x:Name="OpenOutBtn" Style="{StaticResource Btn.Secondary}" Margin="10,0,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,7,0"/>
                        <TextBlock Text="打开输出位置"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CancelBtn" Style="{StaticResource Btn.Secondary}" Content="取消" Margin="10,0,0,0" Visibility="Collapsed"/>
                <Button x:Name="StartBtn" Style="{StaticResource Btn.Primary}" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDE1;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="开始导出"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{StaticResource B.Text2}" TextTrimming="CharacterEllipsis" Text="添加文件后就可以开始导出"/>
                <ProgressBar x:Name="Progress" Style="{StaticResource ThinProgress}" Margin="0,8,0,0" Width="380" HorizontalAlignment="Left" Maximum="1" Value="0" Visibility="Collapsed"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Grid>
