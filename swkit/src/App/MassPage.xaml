<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PageRoot" AllowDrop="True" Background="White">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ 标题 ============ -->
    <StackPanel Margin="36,40,150,18">
        <TextBlock Text="质量估算" Style="{StaticResource T.LargeTitle}"/>
        <TextBlock Style="{StaticResource T.Secondary}" Margin="0,6,0,0" MaxWidth="820" HorizontalAlignment="Left" TextWrapping="Wrap"
                   Text="把装配体拖进来，列出每一种零件和数量，给每个零件选材料（碳纤维、铝合金、钢、塑料、3D 打印、金属打印……共 100 种左右），算出总质量和重心。外购件可以直接填实测质量。"/>
        <WrapPanel Margin="0,8,0,0">
            <Button x:Name="SampleLink" Style="{StaticResource Btn.Text}" Content="示例：小装配体（STEP）" FontSize="12.5"/>
        </WrapPanel>
    </StackPanel>

    <!-- ============ 装配体信息 ============ -->
    <Border x:Name="PartBar" Grid.Row="1" Style="{StaticResource Group}" Margin="36,0,30,12" Padding="14,10" Visibility="Collapsed">
        <DockPanel>
            <Border Width="36" Height="36" CornerRadius="10" Background="#FFF4E5" DockPanel.Dock="Left">
                <TextBlock Text="&#xE8EF;" Style="{StaticResource T.Icon}" FontSize="16" Foreground="#B25000"/>
            </Border>
            <Button x:Name="ChangeBtn" DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" Content="更换…" VerticalAlignment="Center"/>
            <Button x:Name="ReloadBtn" DockPanel.Dock="Right" Style="{StaticResource Btn.Text}" Content="重新读取" VerticalAlignment="Center" Margin="0,0,12,0"
                    ToolTip="在 SolidWorks 里改过零件后，重新读一遍体积（材料选择会保留）"/>
            <StackPanel Margin="12,0,16,0" VerticalAlignment="Center">
                <TextBlock x:Name="AsmName" Style="{StaticResource T.Headline}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="AsmPath" FontSize="11.5" Foreground="{StaticResource B.Text3}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>
    </Border>

    <!-- ============ 主体 ============ -->
    <Grid Grid.Row="2" Margin="36,0,30,18">
        <Grid x:Name="EmptyState">
            <Rectangle RadiusX="16" RadiusY="16" Stroke="#C9C9CF" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="#FAFAFC"/>
            <Viewbox StretchDirection="DownOnly" Margin="16">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8" Width="760">
                    <Border Width="64" Height="64" CornerRadius="19" Background="#FFF4E5" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8EF;" Style="{StaticResource T.Icon}" FontSize="27" Foreground="#B25000"/>
                    </Border>
                    <TextBlock Text="把装配体或零件拖到这里" Style="{StaticResource T.Title}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock Style="{StaticResource T.Secondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="560" TextWrapping="Wrap"
                               Text="支持 .sldasm / .sldprt（在后台 SolidWorks 里只读打开，体积按 SolidWorks 的精确值）和 .step / .stp / .stl（不需要 SolidWorks）。只读取，不会修改文件。"/>
                    <UniformGrid x:Name="HowSteps" Columns="3" Margin="0,24,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button x:Name="PickBtn" Style="{StaticResource Btn.Primary}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="White" Margin="0,0,7,0"/>
                                <TextBlock Text="选择装配体"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SampleBtn" Style="{StaticResource Btn.Secondary}" Content="打开示例" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Viewbox>
        </Grid>

        <StackPanel x:Name="BusyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <Grid Width="44" Height="44" HorizontalAlignment="Center">
                <Ellipse Stroke="#E8E8ED" StrokeThickness="4"/>
                <Ellipse x:Name="Spinner" Stroke="#0071E3" StrokeThickness="4" StrokeDashArray="9 30" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <TextBlock x:Name="BusyText" Style="{StaticResource T.Title}" FontSize="15" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock x:Name="BusyDetail" Style="{StaticResource T.Secondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid x:Name="WorkState" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>
            <!-- 零件表 -->
            <Border Style="{StaticResource Card}" Margin="0,0,18,0" Padding="0">
                <DockPanel>
                    <!-- 工具条：搜索、全选、批量设材料、排序 -->
                    <Border DockPanel.Dock="Top" Padding="14,10,14,8" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1">
                        <WrapPanel>
                            <Grid Width="200" Height="34" Margin="0,2,12,2" VerticalAlignment="Center">
                                <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Padding="28,0,8,0" VerticalContentAlignment="Center"/>
                                <TextBlock Text="&#xE721;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{StaticResource B.Text3}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock x:Name="SearchHint" Text="搜索零件名" FontSize="12.5" Foreground="{StaticResource B.Text3}" Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                            <Button x:Name="BulkBtn" Style="{StaticResource Btn.Secondary}" Content="给勾选的零件设材料…" Margin="0,2,12,2" IsEnabled="False"/>
                            <Button x:Name="UnsetBtn" Style="{StaticResource Btn.Text}" Content="勾选没选材料的" Margin="0,2,16,2" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2" VerticalAlignment="Center">
                                <TextBlock Text="排序" FontSize="12.5" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SortMass" GroupName="msort" Style="{StaticResource Segment}" Content="质量" IsChecked="True"/>
                                        <RadioButton x:Name="SortName" GroupName="msort" Style="{StaticResource Segment}" Content="名称"/>
                                        <RadioButton x:Name="SortQty" GroupName="msort" Style="{StaticResource Segment}" Content="数量"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                    <!-- 表头 -->
                    <Grid x:Name="HeaderRow" DockPanel.Dock="Top" Margin="14,8,22,6"/>
                    <ScrollViewer x:Name="RowScroll" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                        <StackPanel x:Name="Rows" Margin="0,0,0,8"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Padding="0,0,6,0">
                <StackPanel x:Name="SidePanel"/>
            </ScrollViewer>
        </Grid>
    </Grid>

    <!-- ============ 底栏 ============ -->
    <Border Grid.Row="3" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Background="#FCFCFD">
        <DockPanel Margin="36,12,30,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CopyBtn" Style="{StaticResource Btn.Secondary}" Content="复制清单" Margin="0,0,10,0" IsEnabled="False" ToolTip="复制成表格文字，可以直接粘贴到 Excel / 飞书 / 微信"/>
                <Button x:Name="CsvBtn" Style="{StaticResource Btn.Primary}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="导出清单（CSV）…"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="选择一个装配体开始"/>
        </DockPanel>
    </Border>
</Grid>
