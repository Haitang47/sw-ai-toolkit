<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PageRoot" AllowDrop="True" Background="White">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ 标题 ============ -->
    <StackPanel Margin="36,40,150,18">
        <TextBlock Text="工作区" Style="{StaticResource T.LargeTitle}"/>
        <TextBlock Style="{StaticResource T.Secondary}" Margin="0,6,0,0" MaxWidth="740" HorizontalAlignment="Left"
                   Text="把项目文件夹加进来：检查同名文件（SolidWorks 按文件名认零件，不同文件夹里的同名零件会让装配体用错），并在你每次保存时自动留一份历史版本，改坏了、存错了都能退回去。"/>
    </StackPanel>

    <!-- ============ 主体 ============ -->
    <Grid Grid.Row="1" Margin="36,0,30,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 工作区列表 -->
        <DockPanel Margin="0,0,18,0">
            <Button x:Name="AddWsBtn" DockPanel.Dock="Bottom" Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Left" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,7,0"/>
                    <TextBlock Text="添加工作区…"/>
                </StackPanel>
            </Button>
            <TextBlock DockPanel.Dock="Top" Text="我的工作区" Style="{StaticResource T.Section}" Margin="10,0,0,6"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                <StackPanel x:Name="WsList"/>
            </ScrollViewer>
        </DockPanel>

        <!-- 空状态 -->
        <Grid x:Name="EmptyState" Grid.Column="1">
            <Rectangle RadiusX="16" RadiusY="16" Stroke="#C9C9CF" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="#FAFAFC"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <Border Width="68" Height="68" CornerRadius="20" Background="{StaticResource B.AccentTint}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource T.Icon}" FontSize="28" Foreground="{StaticResource B.Accent}"/>
                </Border>
                <TextBlock Text="把项目文件夹拖到这里" Style="{StaticResource T.Title}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                <TextBlock Style="{StaticResource T.Secondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="460"
                           Text="一个工作区就是一个项目文件夹（包含子文件夹）。添加后会统计里面的 SolidWorks 文件、检查同名文件，并开始自动保存历史版本。只读取，不会改动你的文件。"/>
                <Button x:Name="PickWsBtn" Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,7,0"/>
                        <TextBlock Text="选择文件夹"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 工作区详情 -->
        <Grid x:Name="Detail" Grid.Column="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenWsBtn" Style="{StaticResource Btn.Text}" Content="打开文件夹" VerticalAlignment="Center"/>
                    <Button x:Name="RemoveWsBtn" Style="{StaticResource Btn.Text}" Content="移除" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="只是从列表里移除，不会删除任何文件"/>
                </StackPanel>
                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabOverview" GroupName="wstab" Style="{StaticResource Segment}" Content="概览"/>
                        <RadioButton x:Name="TabDup" GroupName="wstab" Style="{StaticResource Segment}" Content="重名检查"/>
                        <RadioButton x:Name="TabHistory" GroupName="wstab" Style="{StaticResource Segment}" Content="版本历史"/>
                        <RadioButton x:Name="TabRecover" GroupName="wstab" Style="{StaticResource Segment}" Content="崩溃找回"/>
                    </StackPanel>
                </Border>
            </DockPanel>
            <ScrollViewer x:Name="TabScroll" Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Padding="0,0,6,0">
                <StackPanel x:Name="TabContent"/>
            </ScrollViewer>
        </Grid>
    </Grid>

    <!-- ============ 底栏 ============ -->
    <Border Grid.Row="2" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Background="#FCFCFD">
        <DockPanel Margin="36,12,30,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CancelBtn" Style="{StaticResource Btn.Secondary}" Content="停止" Visibility="Collapsed" Margin="0,0,12,0"/>
                <Button x:Name="ScanBtn" Style="{StaticResource Btn.Primary}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="重新扫描"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{StaticResource B.Text2}" TextTrimming="CharacterEllipsis" Text="添加一个项目文件夹开始"/>
                <ProgressBar x:Name="Progress" Style="{StaticResource ThinProgress}" Margin="0,7,0,0" Width="320" HorizontalAlignment="Left" Maximum="1" Value="0" Visibility="Collapsed"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Grid>
