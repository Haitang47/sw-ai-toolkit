<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PageRoot" AllowDrop="True" Background="White">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ 标题 ============ -->
    <StackPanel Margin="36,40,150,18">
        <TextBlock Text="可制造性检查" Style="{StaticResource T.LargeTitle}"/>
        <TextBlock Style="{StaticResource T.Secondary}" Margin="0,6,0,0" MaxWidth="780" HorizontalAlignment="Left"
                   Text="把零件拖进来，选 3D 打印（FDM / 光固化）或 CNC，自动检查悬垂、薄壁、倒扣、尖内角、深腔、深孔，给出修改建议、推荐摆放方向、用料和时间估算，可以一键生成报告。"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="SampleOverhangLink" Style="{StaticResource Btn.Text}" Content="示例：悬垂件（打印）" FontSize="12.5"/>
            <TextBlock Text="·" Foreground="{StaticResource B.Text3}" Margin="8,0" VerticalAlignment="Center"/>
            <Button x:Name="SampleThinLink" Style="{StaticResource Btn.Text}" Content="示例：薄壁件" FontSize="12.5"/>
            <TextBlock Text="·" Foreground="{StaticResource B.Text3}" Margin="8,0" VerticalAlignment="Center"/>
            <Button x:Name="SampleCncLink" Style="{StaticResource Btn.Text}" Content="示例：CNC 件" FontSize="12.5"/>
        </StackPanel>
    </StackPanel>

    <!-- ============ 零件 + 工艺 ============ -->
    <Border x:Name="PartBar" Grid.Row="1" Style="{StaticResource Group}" Margin="36,0,30,12" Padding="14,10" Visibility="Collapsed">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="10" Background="#EEF6EA">
                <TextBlock Text="&#xE9F5;" Style="{StaticResource T.Icon}" FontSize="16" Foreground="#2E7D32"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                <TextBlock x:Name="PartName" Style="{StaticResource T.Headline}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="PartPath" FontSize="11.5" Foreground="{StaticResource B.Text3}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Text="工艺" FontSize="12.5" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ProcFdm" GroupName="proc" Style="{StaticResource Segment}" Content="FDM 打印"/>
                        <RadioButton x:Name="ProcSla" GroupName="proc" Style="{StaticResource Segment}" Content="光固化"/>
                        <RadioButton x:Name="ProcCnc" GroupName="proc" Style="{StaticResource Segment}" Content="CNC"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Button x:Name="ChangePartBtn" Grid.Column="3" Style="{StaticResource Btn.Secondary}" Content="更换…" VerticalAlignment="Center"/>
        </Grid>
    </Border>

    <!-- ============ 主体 ============ -->
    <Grid Grid.Row="2" Margin="36,0,30,18">
        <Grid x:Name="EmptyState">
            <Rectangle RadiusX="16" RadiusY="16" Stroke="#C9C9CF" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="#FAFAFC"/>
            <Viewbox StretchDirection="DownOnly" Margin="16">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8" Width="780">
                    <Border Width="64" Height="64" CornerRadius="19" Background="#EEF6EA" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE9F5;" Style="{StaticResource T.Icon}" FontSize="27" Foreground="#2E7D32"/>
                    </Border>
                    <TextBlock Text="把零件拖到这里" Style="{StaticResource T.Title}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock Style="{StaticResource T.Secondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="520"
                               Text="支持 .sldprt（在后台 SolidWorks 里转成 STEP）、.step / .stp 和 .stl。只读取零件，不会修改它。"/>
                    <UniformGrid x:Name="HowSteps" Columns="3" Margin="0,24,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button x:Name="PickPartBtn" Style="{StaticResource Btn.Primary}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="White" Margin="0,0,7,0"/>
                                <TextBlock Text="选择零件"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SampleOverhangBtn" Style="{StaticResource Btn.Secondary}" Content="试试示例：打印件" Margin="10,0,0,0"/>
                        <Button x:Name="SampleCncBtn" Style="{StaticResource Btn.Secondary}" Content="试试示例：CNC 件" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Viewbox>
        </Grid>

        <StackPanel x:Name="BusyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <Grid Width="44" Height="44" HorizontalAlignment="Center">
                <Ellipse Stroke="#E8E8ED" StrokeThickness="4"/>
                <Ellipse x:Name="Spinner" Stroke="#0071E3" StrokeThickness="4" StrokeDashArray="9 30" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <TextBlock x:Name="BusyText" Style="{StaticResource T.Title}" FontSize="15" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock x:Name="BusyDetail" Style="{StaticResource T.Secondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid x:Name="WorkState" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,18,0" ClipToBounds="True">
                <Grid>
                    <Grid x:Name="ViewHost"/>
                    <WrapPanel x:Name="Legend" Margin="14,12,110,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                    <Button x:Name="ResetViewBtn" Style="{StaticResource Btn.Text}" Content="重置视角" Margin="0,10,10,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <TextBlock x:Name="ViewHint" Text="点右侧的问题可以在模型上定位 · 左键拖动旋转 · 滚轮缩放 · 右键拖动平移" FontSize="11.5" Foreground="{StaticResource B.Text3}" Margin="16,0,0,12" VerticalAlignment="Bottom" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Padding="0,0,6,0">
                <StackPanel x:Name="SidePanel"/>
            </ScrollViewer>
        </Grid>
    </Grid>

    <!-- ============ 底栏 ============ -->
    <Border Grid.Row="3" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Background="#FCFCFD">
        <DockPanel Margin="36,12,30,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ReportBtn" Style="{StaticResource Btn.Primary}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="生成报告…"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="选择一个零件开始"/>
        </DockPanel>
    </Border>
</Grid>
