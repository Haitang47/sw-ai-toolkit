<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PageRoot" AllowDrop="True" Background="White">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ 标题 ============ -->
    <DockPanel Margin="36,40,150,18">
        <StackPanel>
            <TextBlock Text="应力分析" Style="{StaticResource T.LargeTitle}"/>
            <TextBlock Style="{StaticResource T.Secondary}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"
                       Text="把零件拖进来，选材料，点选面加约束和载荷，看哪里最危险、安全系数够不够；还可以做拓扑优化，看材料应该放在哪里。网格用开源的 Gmsh 划分，求解器内置，不需要 SolidWorks Simulation 许可。"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="GuideBtn" Style="{StaticResource Btn.Text}" Content="使用指南" FontSize="12.5"/>
                <TextBlock Text="·" Foreground="{StaticResource B.Text3}" Margin="8,0" VerticalAlignment="Center"/>
                <Button x:Name="SampleBracketLink" Style="{StaticResource Btn.Text}" Content="示例：L 形支架" FontSize="12.5"/>
                <TextBlock Text="·" Foreground="{StaticResource B.Text3}" Margin="8,0" VerticalAlignment="Center"/>
                <Button x:Name="SampleTopoLink" Style="{StaticResource Btn.Text}" Content="示例：悬臂块拓扑优化" FontSize="12.5"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>

    <!-- ============ 零件 ============ -->
    <Border x:Name="PartBar" Grid.Row="1" Style="{StaticResource Group}" Margin="36,0,30,12" Padding="14,10" Visibility="Collapsed">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="10" Background="#FFF1E6">
                <TextBlock Text="件" FontSize="14" FontWeight="Bold" Foreground="#C2581C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                <TextBlock x:Name="PartName" Style="{StaticResource T.Headline}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="PartPath" FontSize="11.5" Foreground="{StaticResource B.Text3}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Text="网格" FontSize="12.5" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="MeshCoarse" GroupName="mesh" Style="{StaticResource Segment}" Content="粗" ToolTip="算得快，适合先看大概"/>
                        <RadioButton x:Name="MeshNormal" GroupName="mesh" Style="{StaticResource Segment}" Content="标准"/>
                        <RadioButton x:Name="MeshFine" GroupName="mesh" Style="{StaticResource Segment}" Content="细" ToolTip="更准，但更慢"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Button x:Name="ChangePartBtn" Grid.Column="3" Style="{StaticResource Btn.Secondary}" Content="更换…" VerticalAlignment="Center"/>
        </Grid>
    </Border>

    <!-- ============ 主体 ============ -->
    <Grid Grid.Row="2" Margin="36,0,30,18">
        <!-- 空状态 -->
        <Grid x:Name="EmptyState">
            <Rectangle RadiusX="16" RadiusY="16" Stroke="#C9C9CF" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="#FAFAFC"/>
            <!-- 窗口很小时整体等比缩小，按钮不会被裁掉 -->
            <Viewbox StretchDirection="DownOnly" Margin="16">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8" Width="820">
                <Border Width="64" Height="64" CornerRadius="19" Background="{StaticResource B.AccentTint}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource T.Icon}" FontSize="27" Foreground="{StaticResource B.Accent}"/>
                </Border>
                <TextBlock Text="把零件拖到这里" Style="{StaticResource T.Title}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock Style="{StaticResource T.Secondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="480"
                           Text="支持 .sldprt（在后台 SolidWorks 里转成 STEP）和 .step / .stp。分析单个零件的线弹性静力问题：材料不屈服、变形不大时结果可靠。"/>
                <!-- 三步上手 -->
                <UniformGrid x:Name="HowSteps" Columns="3" Margin="0,24,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button x:Name="PickPartBtn" Style="{StaticResource Btn.Primary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="White" Margin="0,0,7,0"/>
                            <TextBlock Text="选择零件"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SampleBracketBtn" Style="{StaticResource Btn.Secondary}" Content="试试示例：L 形支架" Margin="10,0,0,0"/>
                    <Button x:Name="SampleTopoBtn" Style="{StaticResource Btn.Secondary}" Content="试试示例：拓扑优化" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
            </Viewbox>
        </Grid>

        <!-- 处理中 -->
        <StackPanel x:Name="BusyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <Grid Width="44" Height="44" HorizontalAlignment="Center">
                <Ellipse Stroke="#E8E8ED" StrokeThickness="4"/>
                <Ellipse x:Name="Spinner" Stroke="#0071E3" StrokeThickness="4" StrokeDashArray="9 30" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <TextBlock x:Name="BusyText" Style="{StaticResource T.Title}" FontSize="15" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock x:Name="BusyDetail" Style="{StaticResource T.Secondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- 工作区 -->
        <Grid x:Name="WorkState" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <!-- 分步引导 -->
            <Border Grid.ColumnSpan="2" Background="#F7F8FA" CornerRadius="12" Padding="14,10,14,10" Margin="0,0,0,12">
                <DockPanel>
                    <StackPanel x:Name="GuideSteps" Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GuideTip" FontSize="12.5" Foreground="{StaticResource B.Text}" VerticalAlignment="Center" Margin="18,0,0,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,18,0" ClipToBounds="True">
                <Grid x:Name="CaptureHost" Background="White">
                    <Grid x:Name="ViewHost"/>
                    <!-- 结果开关 -->
                    <WrapPanel x:Name="ResultBar" Margin="14,12,110,0" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ShowVm" GroupName="show" Style="{StaticResource Segment}" Content="等效应力" ToolTip="von Mises 等效应力：塑性材料（钢、铝、多数塑料）看它"/>
                                <RadioButton x:Name="ShowP1" GroupName="show" Style="{StaticResource Segment}" Content="最大主应力" ToolTip="最大拉应力：脆性材料（铸铁、碳纤维、玻纤、树脂）看它"/>
                                <RadioButton x:Name="ShowDisp" GroupName="show" Style="{StaticResource Segment}" Content="位移"/>
                                <RadioButton x:Name="ShowUtil" GroupName="show" Style="{StaticResource Segment}" Content="强度利用率" ToolTip="应力 ÷ 强度 = 1 ÷ 安全系数；超过 100% 的地方会失效"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="16,4,0,4">
                            <CheckBox x:Name="ShowDeform" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="DeformText" Text="显示变形" FontSize="12.5" Foreground="{StaticResource B.Text2}"/>
                            </CheckBox>
                            <Button x:Name="BackToEditBtn" Style="{StaticResource Btn.Text}" Content="返回编辑" ToolTip="返回编辑约束和载荷" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>
                    <Button x:Name="ResetViewBtn" Style="{StaticResource Btn.Text}" Content="重置视角" Margin="0,10,10,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <!-- 颜色条 -->
                    <Grid x:Name="Legend" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="LegendBar" Height="220" CornerRadius="4"/>
                        <Grid Grid.Column="1" Margin="8,0,0,0" Height="236">
                            <TextBlock x:Name="LegendMax" VerticalAlignment="Top" FontSize="11.5" Foreground="{StaticResource B.Text2}"/>
                            <TextBlock x:Name="LegendMid" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource B.Text2}"/>
                            <TextBlock x:Name="LegendMin" Text="0" VerticalAlignment="Bottom" FontSize="11.5" Foreground="{StaticResource B.Text2}"/>
                        </Grid>
                        <TextBlock x:Name="LegendTitle" Grid.ColumnSpan="2" Text="等效应力 MPa" FontSize="11" Foreground="{StaticResource B.Text3}" Margin="0,-26,0,0" VerticalAlignment="Top"/>
                    </Grid>
                    <!-- 选中面的操作 -->
                    <Border x:Name="SelBar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Padding="14,8" CornerRadius="12" Background="White"
                            BorderBrush="#E3E3E8" BorderThickness="1" Effect="{StaticResource Shadow.Small}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SelText" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Button x:Name="SelFixBtn" Style="{StaticResource Btn.Secondary}" Content="固定" Margin="0,0,6,0"/>
                            <Button x:Name="SelForceBtn" Style="{StaticResource Btn.Secondary}" Content="加力" Margin="0,0,6,0"/>
                            <Button x:Name="SelPressureBtn" Style="{StaticResource Btn.Secondary}" Content="加压力" Margin="0,0,6,0"/>
                            <Button x:Name="SelTorqueBtn" Style="{StaticResource Btn.Secondary}" Content="加扭矩" Margin="0,0,6,0"/>
                            <Button x:Name="SelClearBtn" Style="{StaticResource Btn.Text}" Content="取消"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ViewHint" Text="单击选面，按住 Ctrl 多选 · 左键拖动旋转 · 滚轮缩放 · 右键拖动平移" FontSize="11.5" Foreground="{StaticResource B.Text3}" Margin="16,0,0,12" VerticalAlignment="Bottom" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Padding="0,0,6,0">
                <StackPanel x:Name="SidePanel"/>
            </ScrollViewer>
        </Grid>
    </Grid>

    <!-- ============ 底栏 ============ -->
    <Border Grid.Row="3" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Background="#FCFCFD">
        <DockPanel Margin="36,12,30,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ReportBtn" Style="{StaticResource Btn.Secondary}" Content="生成报告…" Margin="0,0,12,0" Visibility="Collapsed" ToolTip="生成实验 / 论文报告：Word（方法、结果、收敛性、参考文献）+ 300 dpi 图片 + CSV 原始数据"/>
                <Button x:Name="TopoBtn" Style="{StaticResource Btn.Secondary}" Content="拓扑优化…" Visibility="Collapsed" ToolTip="只保留一部分材料，看在这些约束和载荷下材料应该放在哪里"/>
                <Button x:Name="RefineBtn" Style="{StaticResource Btn.Secondary}" Content="自适应加密" Margin="12,0,0,0" Visibility="Collapsed" ToolTip="按误差分布在应力变化剧烈的地方自动加密网格并重算，直到结果收敛（和 SolidWorks Simulation 的 H 自适应同一思路）"/>
                <Button x:Name="SolveBtn" Style="{StaticResource Btn.Primary}" Margin="12,0,0,0" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock x:Name="SolveText" Text="开始计算"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="选择一个零件开始"/>
        </DockPanel>
    </Border>

    <!-- ============ 使用指南（浮层） ============ -->
    <Grid x:Name="GuideOverlay" Grid.RowSpan="4" Background="#66000000" Visibility="Collapsed">
        <Border Style="{StaticResource Card}" MaxWidth="820" Margin="60,50" Background="White">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="22,14,14,12">
                    <DockPanel>
                        <Button x:Name="GuideCloseBtn" DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" Content="关闭"/>
                        <TextBlock Text="应力分析和拓扑优化 · 使用指南" Style="{StaticResource T.Title}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <FlowDocumentScrollViewer x:Name="GuideReader" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>
    </Grid>
</Grid>
