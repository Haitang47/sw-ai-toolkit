<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PageRoot" AllowDrop="True" Background="White">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ 标题 ============ -->
    <StackPanel Margin="36,40,150,18">
        <TextBlock Text="CFD 流场" Style="{StaticResource T.LargeTitle}"/>
        <TextBlock Style="{StaticResource T.Secondary}" Margin="0,6,0,0" MaxWidth="860" HorizontalAlignment="Left" TextWrapping="Wrap"
                   Text="把整机拖进来，放上转子和涵道（按作动盘处理，给推力），算出周围的流场：下洗、桨间干扰、机身受到的下洗力、涵道的附加推力，画出按速度着色的流线。求解器内置（格子玻尔兹曼 + LES），有显卡时用显卡算。"/>
        <WrapPanel Margin="0,8,0,0">
            <Button x:Name="SampleLink" Style="{StaticResource Btn.Text}" Content="示例：四旋翼悬停" FontSize="12.5"/>
        </WrapPanel>
    </StackPanel>

    <!-- ============ 模型 ============ -->
    <Border x:Name="PartBar" Grid.Row="1" Style="{StaticResource Group}" Margin="36,0,30,12" Padding="14,10" Visibility="Collapsed">
        <DockPanel>
            <Border Width="36" Height="36" CornerRadius="10" Background="#EAF3FE" DockPanel.Dock="Left">
                <TextBlock Text="&#xE709;" Style="{StaticResource T.Icon}" FontSize="16" Foreground="#0071E3"/>
            </Border>
            <Button x:Name="ChangeBtn" DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" Content="更换…" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Text="向上" FontSize="12.5" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="UpY" GroupName="cfdup" Style="{StaticResource Segment}" Content="+Y" IsChecked="True" ToolTip="SolidWorks 默认 Y 向上"/>
                        <RadioButton x:Name="UpZ" GroupName="cfdup" Style="{StaticResource Segment}" Content="+Z" ToolTip="很多别的 CAD 是 Z 向上"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Margin="12,0,16,0" VerticalAlignment="Center">
                <TextBlock x:Name="ModelName" Style="{StaticResource T.Headline}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ModelPath" FontSize="11.5" Foreground="{StaticResource B.Text3}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>
    </Border>

    <!-- ============ 主体 ============ -->
    <Grid Grid.Row="2" Margin="36,0,30,18">
        <Grid x:Name="EmptyState">
            <Rectangle RadiusX="16" RadiusY="16" Stroke="#C9C9CF" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="#FAFAFC"/>
            <Viewbox StretchDirection="DownOnly" Margin="16">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8" Width="780">
                    <Border Width="64" Height="64" CornerRadius="19" Background="#EAF3FE" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE709;" Style="{StaticResource T.Icon}" FontSize="27" Foreground="#0071E3"/>
                    </Border>
                    <TextBlock Text="把整机（装配体）拖到这里" Style="{StaticResource T.Title}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock Style="{StaticResource T.Secondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="580" TextWrapping="Wrap"
                               Text="支持 .sldasm / .sldprt（在后台 SolidWorks 里只读转成 STEP）、.step / .stp 和 .stl。桨叶不用建模，用作动盘代替；建了也可以，计算前会提示把桨叶隐藏或删掉。"/>
                    <UniformGrid x:Name="HowSteps" Columns="3" Margin="0,24,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button x:Name="PickBtn" Style="{StaticResource Btn.Primary}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="White" Margin="0,0,7,0"/>
                                <TextBlock Text="选择模型"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SampleBtn" Style="{StaticResource Btn.Secondary}" Content="打开示例" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Viewbox>
        </Grid>

        <StackPanel x:Name="BusyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <Grid Width="44" Height="44" HorizontalAlignment="Center">
                <Ellipse Stroke="#E8E8ED" StrokeThickness="4"/>
                <Ellipse x:Name="Spinner" Stroke="#0071E3" StrokeThickness="4" StrokeDashArray="9 30" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <TextBlock x:Name="BusyText" Style="{StaticResource T.Title}" FontSize="15" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock x:Name="BusyDetail" Style="{StaticResource T.Secondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid x:Name="WorkState" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,18,0" ClipToBounds="True">
                <Grid>
                    <Grid x:Name="ViewHost"/>
                    <!-- 流线种子 -->
                    <WrapPanel x:Name="SeedBar" Margin="14,12,120,0" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                        <TextBlock Text="流线从" FontSize="12" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ToggleButton x:Name="SeedInlet" Style="{StaticResource Chip}" Content="盘面进口" IsChecked="True"/>
                        <ToggleButton x:Name="SeedTip" Style="{StaticResource Chip}" Content="桨尖外圈" IsChecked="True"/>
                        <ToggleButton x:Name="SeedAbove" Style="{StaticResource Chip}" Content="盘面上方"/>
                        <ToggleButton x:Name="SliceToggle" Style="{StaticResource Chip}" Content="竖直切面"/>
                    </WrapPanel>
                    <Button x:Name="ResetViewBtn" Style="{StaticResource Btn.Text}" Content="重置视角" Margin="0,10,10,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <!-- 色标 -->
                    <Border x:Name="Legend" Margin="16,0,0,36" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#E6FFFFFF" CornerRadius="8" Padding="10,6" Visibility="Collapsed" IsHitTestVisible="False">
                        <StackPanel>
                            <TextBlock Text="速度 U (m/s)" FontSize="11" Foreground="{StaticResource B.Text2}"/>
                            <Rectangle x:Name="LegendBar" Width="220" Height="10" RadiusX="2" RadiusY="2" Margin="0,4,0,2"/>
                            <Grid Width="220">
                                <TextBlock x:Name="LegendMin" Text="0" FontSize="11" Foreground="{StaticResource B.Text2}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="LegendMid" FontSize="11" Foreground="{StaticResource B.Text2}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="LegendMax" FontSize="11" Foreground="{StaticResource B.Text2}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ViewHint" Text="左键拖动旋转 · 滚轮缩放 · 右键拖动平移" FontSize="11.5" Foreground="{StaticResource B.Text3}" Margin="16,0,0,12" VerticalAlignment="Bottom" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Padding="0,0,6,0">
                <StackPanel x:Name="SidePanel"/>
            </ScrollViewer>
        </Grid>
    </Grid>

    <!-- ============ 底栏 ============ -->
    <Border Grid.Row="3" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Background="#FCFCFD">
        <DockPanel Margin="36,12,30,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ShotBtn" Style="{StaticResource Btn.Secondary}" Content="保存图片…" Margin="0,0,10,0" IsEnabled="False"/>
                <Button x:Name="VtkBtn" Style="{StaticResource Btn.Secondary}" Content="导出 VTK…" Margin="0,0,10,0" IsEnabled="False" ToolTip="时间平均的速度场，ParaView 可以直接打开"/>
                <Button x:Name="RunBtn" Style="{StaticResource Btn.Primary}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RunIcon" Text="&#xE768;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock x:Name="RunText" Text="开始计算"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="选择一个模型开始"/>
        </DockPanel>
    </Border>
</Grid>
