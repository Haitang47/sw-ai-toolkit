<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PageRoot" AllowDrop="True" Background="White">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ 标题 ============ -->
    <StackPanel Margin="36,40,150,18">
        <TextBlock Text="URDF 导出" Style="{StaticResource T.LargeTitle}"/>
        <TextBlock Style="{StaticResource T.Secondary}" Margin="0,6,0,0" MaxWidth="700" HorizontalAlignment="Left"
                   Text="根据装配体的配合识别关节；没有配合的零件按几何推断（同轴的轴和孔、轴承、电机 / 舵机输出端、导轨），导出 ROS 功能包（ROS 1 和 ROS 2 通用）并自动检查。装配体在后台独立的 SolidWorks 里只读打开，不会被修改。"/>
    </StackPanel>

    <!-- ============ 装配体 ============ -->
    <Border x:Name="AsmBar" Grid.Row="1" Style="{StaticResource Group}" Margin="36,0,30,16" Padding="14,10" Visibility="Collapsed">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="10" Background="#F3EBF8">
                <TextBlock Text="装" FontSize="14" FontWeight="Bold" Foreground="#8944AB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                <TextBlock x:Name="AsmName" Style="{StaticResource T.Headline}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="AsmPath" FontSize="11.5" Foreground="{StaticResource B.Text3}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                <CheckBox x:Name="ExpandSubs" Style="{StaticResource Switch}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,22,0"
                          ToolTip="打开：子装配体（包括 SolidWorks 里的刚性子装配体）里的配合也用来识别关节，例如夹爪、舵机模块。&#x0a;关闭：刚性子装配体整体当作一个零件，和 SolidWorks 里的行为一致。">
                    <TextBlock Text="分析子装配体内部" FontSize="12.5" Foreground="{StaticResource B.Text2}"/>
                </CheckBox>
                <TextBlock Text="模型上方向" FontSize="12.5" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="UpY" GroupName="up" Style="{StaticResource Segment}" Content="Y" ToolTip="SolidWorks 默认 Y 向上，导出时转成 ROS 的 Z 向上"/>
                        <RadioButton x:Name="UpZ" GroupName="up" Style="{StaticResource Segment}" Content="Z" ToolTip="模型本来就是 Z 向上，不做转换"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Button x:Name="ChangeAsmBtn" Grid.Column="3" Style="{StaticResource Btn.Secondary}" Content="更换…" VerticalAlignment="Center"/>
            <Button x:Name="AnalyzeBtn" Grid.Column="4" Style="{StaticResource Btn.Primary}" Content="重新分析" Height="32" Padding="16,0" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </Grid>
    </Border>

    <!-- ============ 主体 ============ -->
    <Grid Grid.Row="2" Margin="36,0,30,18">
        <!-- 空状态 -->
        <Grid x:Name="EmptyState">
            <Rectangle RadiusX="16" RadiusY="16" Stroke="#C9C9CF" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="#FAFAFC"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <Border Width="68" Height="68" CornerRadius="20" Background="{StaticResource B.AccentTint}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE71B;" Style="{StaticResource T.Icon}" FontSize="28" Foreground="{StaticResource B.Accent}"/>
                </Border>
                <TextBlock Text="把装配体拖到这里" Style="{StaticResource T.Title}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                <TextBlock Style="{StaticResource T.Secondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="420"
                           Text="支持 .sldasm。有配合时按配合识别（转动用「同心 + 端面重合」，移动用两组面重合，限位用限位配合）；没有配合、或者配合全锁死也没关系，会按零件几何推断旋转轴和移动方向。"/>
                <Button x:Name="PickAsmBtn" Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,7,0"/>
                        <TextBlock Text="选择装配体"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 分析中 -->
        <StackPanel x:Name="BusyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <Grid Width="44" Height="44" HorizontalAlignment="Center">
                <Ellipse Stroke="#E8E8ED" StrokeThickness="4"/>
                <Ellipse x:Name="Spinner" Stroke="#0071E3" StrokeThickness="4" StrokeDashArray="9 30" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <TextBlock x:Name="BusyText" Style="{StaticResource T.Title}" FontSize="15" HorizontalAlignment="Center" Margin="0,18,0,0" Text="正在分析装配体"/>
            <TextBlock x:Name="BusyDetail" Style="{StaticResource T.Secondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- 结果 -->
        <Grid x:Name="ResultState" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,18,0" ClipToBounds="True">
                <Grid>
                    <Grid x:Name="ViewHost"/>
                    <TextBlock Text="左键拖动旋转 · 滚轮缩放 · 右键拖动平移 · 蓝色箭头：配合识别的关节轴 · 紫色：几何推断 · 灰色：未启用的建议" TextTrimming="CharacterEllipsis" FontSize="11.5" Foreground="{StaticResource B.Text3}" Margin="16,0,0,12" VerticalAlignment="Bottom" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,10,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="AxesBtn" Style="{StaticResource Btn.Text}" Content="隐藏关节轴" Margin="0,0,6,0"/>
                        <Button x:Name="ResetViewBtn" Style="{StaticResource Btn.Text}" Content="重置视角"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Padding="0,0,6,0">
                <StackPanel x:Name="SidePanel"/>
            </ScrollViewer>
        </Grid>
    </Grid>

    <!-- ============ 底栏 ============ -->
    <Border Grid.Row="3" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Background="#FCFCFD">
        <DockPanel Margin="36,12,30,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="OpenReportBtn" Style="{StaticResource Btn.Text}" Content="查看校验报告" Visibility="Collapsed" VerticalAlignment="Center"/>
                <Button x:Name="OpenPkgBtn" Style="{StaticResource Btn.Secondary}" Margin="10,0,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,7,0"/>
                        <TextBlock Text="打开功能包"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ExportBtn" Style="{StaticResource Btn.Primary}" Margin="12,0,0,0" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDE1;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="导出 URDF"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="机器人名" FontSize="12.5" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="RobotName" Style="{StaticResource Field}" Width="150" Text="my_robot"/>
                    <TextBlock Text="输出到" FontSize="12.5" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" Margin="18,0,8,0"/>
                    <TextBlock x:Name="OutDirText" FontSize="12" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="ChooseOutBtn" Style="{StaticResource Btn.Text}" Content="更改" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{StaticResource B.Text2}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" Text="选择一个装配体开始"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Grid>
