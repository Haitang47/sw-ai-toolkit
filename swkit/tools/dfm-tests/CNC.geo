// 可制造性测试件：CNC。60×40×20 的块：
//  · 深窄槽：宽 2、深 12、长 30（深宽比 6），两端是尖内角
//  · 封闭的 T 型槽（倒扣）：槽口宽 4、深 4，下面宽 8、高 4，长 15
//  · R1 圆角的矩形腔：20×10、深 8（内圆角 R1）
//  · 深小孔：Φ2 沿 X 贯穿 60（深径比 30）
SetFactory("OpenCASCADE");
Box(1) = {0, 0, 0, 60, 40, 20};
Box(2) = {5, 5, 8, 30, 2, 13};
Box(3) = {40, 10, 16, 15, 4, 5};
Box(4) = {40, 8, 12, 15, 8, 4};
Rectangle(100) = {5, 25, 12, 20, 10, 1};
pk() = Extrude {0, 0, 9} { Surface{100}; };
Cylinder(20) = {-1, 32, 5, 62, 0, 0, 1};
BooleanDifference{ Volume{1}; Delete; }{ Volume{2, 3, 4, pk[1], 20}; Delete; }

// 转成 SolidWorks 的习惯：Y 向上
Rotate {{1, 0, 0}, {0, 0, 0}, -Pi/2} { Volume{:}; }
