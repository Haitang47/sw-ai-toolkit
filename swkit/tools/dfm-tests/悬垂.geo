// 可制造性测试件：悬垂。截面在 XZ 平面，沿 Y 拉伸 20 mm。
// 左侧悬垂底面与水平面成 30°（按 45° 规则要支撑），右侧成 60°（不用支撑）。
// Z 向上打印时：要支撑的面积 = 20 × 20 = 400 mm²；投影面积 17.32 × 20 = 346.4 mm²；支撑体积 ≈ 346.4 × 15 = 5196 mm³。
SetFactory("OpenCASCADE");
Point(1) = {0, 0, 0}; Point(2) = {20, 0, 0}; Point(3) = {20, 0, 10}; Point(4) = {25.773503, 0, 20};
Point(5) = {-17.320508, 0, 20}; Point(6) = {0, 0, 10};
Line(1) = {1, 2}; Line(2) = {2, 3}; Line(3) = {3, 4}; Line(4) = {4, 5}; Line(5) = {5, 6}; Line(6) = {6, 1};
Curve Loop(1) = {1, 2, 3, 4, 5, 6}; Plane Surface(1) = {1};
Extrude {0, 20, 0} { Surface{1}; }
