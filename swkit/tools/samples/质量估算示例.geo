// 质量估算示例：底板 100×60×5、4 根 Φ10×20 立柱、一个 20×20×20 方块（内部有 R5 球形空腔）。
// 全部 6061-T6（2.70 g/cm³）时总质量 118.15 g，重心 (50, 30, 10.70) mm
SetFactory("OpenCASCADE");
// 底板 100×60×5（原点在角上）
Box(1) = {0, 0, 0, 100, 60, 5};
// 4 根柱子 Φ10×20，立在底板上
Cylinder(2) = {10, 10, 5, 0, 0, 20, 5};
Cylinder(3) = {90, 10, 5, 0, 0, 20, 5};
Cylinder(4) = {10, 50, 5, 0, 0, 20, 5};
Cylinder(5) = {90, 50, 5, 0, 0, 20, 5};
// 中间一个 20×20×20 的方块，里面挖一个 R5 的球形空腔（封闭）
Box(6) = {40, 20, 30, 20, 20, 20};
Sphere(7) = {50, 30, 40, 5};
BooleanDifference(8) = { Volume{6}; Delete; }{ Volume{7}; Delete; };
Save "质量估算示例.step";