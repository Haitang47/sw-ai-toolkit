// CFD 示例：简化的 5 寸四旋翼（Y 向上，单位 mm）。机身 70×30×70，X 形机臂（长 113、宽 14、厚 5），4 个 Φ28×16 电机。
// 桨盘（页面里自动放）：中心 (±80, 26, ±80)，Φ127（5 寸），每个推力 4 N，相邻反转。
SetFactory("OpenCASCADE");
Box(1) = {-35, -12, -35, 70, 30, 70};
// 机臂：沿 X 方向的长条，绕 Y 转 ±45°
Box(2) = {0, -2.5, -7, 113, 5, 14};
Rotate {{0, 1, 0}, {0, 0, 0}, Pi/4} { Volume{2}; }
Box(3) = {0, -2.5, -7, 113, 5, 14};
Rotate {{0, 1, 0}, {0, 0, 0}, 3*Pi/4} { Volume{3}; }
Box(4) = {0, -2.5, -7, 113, 5, 14};
Rotate {{0, 1, 0}, {0, 0, 0}, -Pi/4} { Volume{4}; }
Box(5) = {0, -2.5, -7, 113, 5, 14};
Rotate {{0, 1, 0}, {0, 0, 0}, -3*Pi/4} { Volume{5}; }
// 电机（立在机臂末端）
Cylinder(6) = {80, 2.5, 80, 0, 16, 0, 14};
Cylinder(7) = {-80, 2.5, 80, 0, 16, 0, 14};
Cylinder(8) = {80, 2.5, -80, 0, 16, 0, 14};
Cylinder(9) = {-80, 2.5, -80, 0, 16, 0, 14};
BooleanUnion(10) = { Volume{1}; Delete; }{ Volume{2, 3, 4, 5, 6, 7, 8, 9}; Delete; };
Save "四旋翼示例.step";